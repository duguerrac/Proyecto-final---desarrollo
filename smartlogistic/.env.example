# ─────────────────────────────
# SmartLogistic — Variables de Entorno
# ─────────────────────────────

# PostgreSQL (WarehouseCore)
POSTGRES_DB=warehouse_db
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse_pass
POSTGRES_PORT=5432

# Redis (RobotStatus)
REDIS_PORT=6379

# MongoDB (LogisticsAnalytics)
MONGO_DB=logistics_analytics
MONGO_PORT=27017

# NATS
NATS_PORT=4222
NATS_HTTP_PORT=8222

# Nginx
NGINX_PORT=8080

# Microservicios
WAREHOUSE_CORE_PORT=8081
ROBOT_STATUS_PORT=8082
ANALYTICS_PORT=8083

# Observabilidad
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOKI_PORT=3100
