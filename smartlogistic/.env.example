# ─────────────────────────────
# SmartLogistic — Variables de Entorno
# ─────────────────────────────

# PostgreSQL Auth (MS-Identity)
AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=auth_pass
AUTH_POSTGRES_PORT=5433

# PostgreSQL Warehouse (WarehouseCore)
WAREHOUSE_POSTGRES_DB=warehouse_db
WAREHOUSE_POSTGRES_USER=warehouse
WAREHOUSE_POSTGRES_PASSWORD=warehouse_pass
WAREHOUSE_POSTGRES_PORT=5432

# Redis (RobotStatus)
REDIS_PORT=6379

# MongoDB (LogisticsAnalytics)
MONGO_DB=logistics_analytics
MONGO_PORT=27017

# NATS
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_WS_PORT=8443

# JWT
JWT_SECRET=smartlogistic-secret-key-change-in-production

# Nginx
NGINX_PORT=8080

# Microservicios
IDENTITY_PORT=8084
WAREHOUSE_CORE_PORT=8081
ROBOT_STATUS_PORT=8082
ANALYTICS_PORT=8083

# Observabilidad
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOKI_PORT=3100

# Jaeger
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_OTLP_GRPC_PORT=4317
